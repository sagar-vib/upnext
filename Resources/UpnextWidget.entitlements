<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- WidgetKit only runs sandboxed widgets. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Reads the snapshot Upnext writes to ~/Library/Application Support/Upnext. This works
         with ad hoc signing, unlike an app group, which needs a team ID. -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
    <array>
        <string>/Library/Application Support/Upnext/</string>
    </array>
</dict>
</plist>
